{
    "version": "0.2.0",
    "configurations": [
		{
			"type": "cortex-debug",
			"request": "launch",
			"name": "Launch Sniffer with OpenOCD (ST-Link)",
			"cwd": "${workspaceFolder}",
			"executable": "${workspaceFolder}/build/sniffer/smbus-sniffer.elf",
			"preLaunchTask": "CMake: build",
			"servertype": "openocd",
			"configFiles": [
				"${workspaceFolder}/debugging/STM32G070RBTx.cfg"
			],
			"device": "STM32G070RB",
			"runToEntryPoint": "main",
			"svdFile": "${workspaceFolder}/debugging/STM32G070.svd",
			"showDevDebugOutput": "raw",
			"swoConfig": {},
			"liveWatch": {
				"enabled": true,
				"samplesPerSecond": 4
			}
		},
    ]
}
